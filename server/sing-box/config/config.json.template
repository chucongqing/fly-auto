{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "::",
      "listen_port": 0,
      "users": [
        {
          "uuid": "",
          "password": ""
        }
      ],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "server_name": "",
        "alpn": [
          "h3"
        ],
        "certificate_path": "/etc/ssl/cert.pem",
        "key_path": "/etc/ssl/key.pem"
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 0,
      "users": [
        {
          "name": "",
          "password": ""
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "",
        "certificate_path": "/etc/ssl/cert.pem",
        "key_path": "/etc/ssl/key.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "warp",
      "server": "",
      "server_port": 0
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "rule_set": [
          "geosite-youtube"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "resolve",
        "strategy": "prefer_ipv6"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "route",
        "outbound": "warp"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-google",
        "type": "local",
        "format": "binary",
        "path": "/usr/local/etc/sing-box/rule-set/geosite-google.srs"
      },
      {
        "tag": "geosite-youtube",
        "type": "local",
        "format": "binary",
        "path": "/usr/local/etc/sing-box/rule-set/geosite-youtube.srs"
      }
    ],
    "final": "direct"
  }
}
